MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123

# Email Provider Configuration ('brevo', 'gmail', or 'resend')
EMAIL_PROVIDER=brevo

# 1. Brevo (Sendinblue) - RECOMMENDED for Render Free Tier (HTTP API over port 443, 300 free emails/day)
# Sign up free at: https://www.brevo.com
# Get API Key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-verified-email@gmail.com
BREVO_SENDER_NAME=CareNest

# 2. Gmail SMTP (works locally, but blocked on Render Free Tier due to SMTP port block):
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# 3. Resend (transactional email provider with custom domain):
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CareNest <onboarding@resend.dev>

# App URLs & OAuth
FRONTEND_URL=https://dmansour2000.github.io/reactjsbabysitterbookingplatformfrontend
GOOGLE_CLIENT_ID=your_google_client_id_here

